#include <cmath>
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "lib/matmul_intf.h"

/*
 * BatchMatmulMaxSum — Ascend C Direct Invocation
 *
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 *   y[b] = sum_m ( max_n ( sum_k x1[b,m,k] * x2[b,k,n] ) )
 *
 * Design
 * ------
 * The judge profiles every iteration and requires EXACTLY ONE kernel launch, so the
 * matmul and both reductions must live in one kernel. The matmul and the reductions
 * run on different engines, hence __mix__(1, 2): 1 AIC + 2 AIV per logical core.
 *
 *   AIC (cube)  : AscendC::Matmul (high level API) -> (M,N) float block in GM
 *   AIV (vector): read that block back from GM, ReduceMax over N, ReduceSum over M
 *
 * The high level Matmul API is used on purpose: it owns ND2NZ conversion, fractal
 * layout, L1/L0 tiling, tail handling and transposed inputs, so this file contains
 * none of that arithmetic. transposeX1/transposeX2 map directly onto the API's
 * transposeA/transposeB flags.
 *
 * dav-2201 has no cube -> vector UB path, so the (M,N) handoff goes through GM.
 * The two sides rendezvous with CrossCoreSetFlag / CrossCoreWaitFlag.
 *
 * Host side (run_kernel) builds the TCubeTiling with matmul_tiling::MultiCoreMatmulTiling
 * and hands it to the kernel through a GM buffer, exactly as the official samples do.
 */

namespace bmms {

constexpr uint8_t CROSS_CORE_FLAG_ID = 0x8;
constexpr uint32_t AIV_PER_CORE = 2;

__aicore__ inline uint32_t AlignUp(uint32_t v, uint32_t a)
{
    return (v + a - 1) / a * a;
}

__aicore__ inline void CopyTiling(TCubeTiling* tiling, __gm__ uint8_t* tilingGm)
{
    uint32_t* dst = reinterpret_cast<uint32_t*>(tiling);
    auto src = reinterpret_cast<__gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); i++, dst++) {
        *dst = *(src + i);
    }
}

template <typename XT>
class KernelBmms {
public:
    using AType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, XT, false>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, XT, false>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float, false>;
    using BiasType = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;

    AscendC::Matmul<AType, BType, CType, BiasType, CFG_NORM> matmulObj;

    __aicore__ inline KernelBmms() {}

    __aicore__ inline void Init(
        __gm__ uint8_t* x1, __gm__ uint8_t* x2, __gm__ uint8_t* y, __gm__ uint8_t* mmGm,
        int64_t B, int64_t M, int64_t N, int64_t K, bool tx1, bool tx2, int64_t coreNum)
    {
        x1Gm.SetGlobalBuffer((__gm__ XT*)x1);
        x2Gm.SetGlobalBuffer((__gm__ XT*)x2);
        yGm.SetGlobalBuffer((__gm__ float*)y);
        mm.SetGlobalBuffer((__gm__ float*)mmGm);

        this->B = static_cast<uint32_t>(B);
        this->M = static_cast<uint32_t>(M);
        this->N = static_cast<uint32_t>(N);
        this->K = static_cast<uint32_t>(K);
        this->tx1 = tx1;
        this->tx2 = tx2;
        this->coreNum = static_cast<uint32_t>(coreNum);
        this->blockIdx = AscendC::GetBlockIdx();
    }

    __aicore__ inline void Process(const TCubeTiling& tiling)
    {
        if ASCEND_IS_AIC {
            RunMatmul(tiling);
        }
        if ASCEND_IS_AIV {
            RunReduce();
        }
    }

private:
    // ============================ AIC: matmul ============================
    __aicore__ inline void RunMatmul(const TCubeTiling& tiling)
    {
        const uint32_t aivRatio = AIV_PER_CORE;
        const uint32_t aicIdx = blockIdx / aivRatio;

        // Batches are strided across the cube cores.
        for (uint32_t b = aicIdx; b < B; b += coreNum) {
            const uint64_t aOff = BatchOffsetX1(b);
            const uint64_t bOff = BatchOffsetX2(b);
            const uint64_t cOff = static_cast<uint64_t>(b) * M * N;

            AscendC::GlobalTensor<XT> aT = x1Gm[aOff];
            AscendC::GlobalTensor<XT> bT = x2Gm[bOff];
            AscendC::GlobalTensor<float> cT = mm[cOff];

            matmulObj.SetTensorA(aT, tx1);
            matmulObj.SetTensorB(bT, tx2);
            matmulObj.IterateAll(cT);
            matmulObj.End();
        }
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(CROSS_CORE_FLAG_ID);
    }

    // x1 logical (B,M,K): storage is (B,M,K) or (B,K,M)
    __aicore__ inline uint64_t BatchOffsetX1(uint32_t b) const
    {
        return tx1 ? static_cast<uint64_t>(b) * K * M : static_cast<uint64_t>(b) * M * K;
    }

    // x2 logical (B,K,N): storage is (B,K,N) or (B,N,K)
    __aicore__ inline uint64_t BatchOffsetX2(uint32_t b) const
    {
        return tx2 ? static_cast<uint64_t>(b) * N * K : static_cast<uint64_t>(b) * K * N;
    }

    // ============================ AIV: reduction ============================
    __aicore__ inline void RunReduce()
    {
        const uint32_t subIdx = AscendC::GetSubBlockIdx() % AIV_PER_CORE;
        const uint32_t aicIdx = blockIdx / AIV_PER_CORE;

        for (uint32_t b = aicIdx; b < B; b += coreNum) {
            AscendC::CrossCoreWaitFlag<0x2>(CROSS_CORE_FLAG_ID);
            ReduceOneBatch(b, subIdx);
        }
    }

    __aicore__ inline void ReduceOneBatch(uint32_t b, uint32_t subIdx)
    {
        // Split the M rows between the two AIV sub-blocks of this logical core.
        const uint32_t rowsPerSub = (M + AIV_PER_CORE - 1) / AIV_PER_CORE;
        const uint32_t mBegin = subIdx * rowsPerSub;
        const uint32_t mEnd = (mBegin + rowsPerSub < M) ? (mBegin + rowsPerSub) : M;
        if (mBegin >= mEnd) {
            return;
        }

        // Chunk rows so that one row-block plus temporaries stays inside UB.
        const uint32_t nAl = AlignUp(N, 8);
        uint32_t chunkRows = 8;
        while (chunkRows > 1 && static_cast<uint64_t>(chunkRows) * nAl * sizeof(float) > 48 * 1024) {
            chunkRows /= 2;
        }
        if (chunkRows < 1) {
            chunkRows = 1;
        }

        AscendC::LocalTensor<float> simBuf(AscendC::TPosition::VECCALC, 0, chunkRows * nAl);
        AscendC::LocalTensor<float> maxBuf(AscendC::TPosition::VECCALC,
                                           chunkRows * nAl * sizeof(float), chunkRows);
        AscendC::LocalTensor<float> sumBuf(AscendC::TPosition::VECCALC,
                                           (chunkRows * nAl + chunkRows) * sizeof(float), 8);

        float acc = 0.0f;
        for (uint32_t r0 = mBegin; r0 < mEnd; r0 += chunkRows) {
            const uint32_t rows = (r0 + chunkRows < mEnd) ? chunkRows : (mEnd - r0);

            AscendC::DataCopyExtParams cp;
            cp.blockCount = static_cast<uint16_t>(rows);
            cp.blockLen = static_cast<uint32_t>(N * sizeof(float));
            cp.srcStride = 0;
            cp.dstStride = 0;
            AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
            AscendC::DataCopyPad<float>(simBuf, mm[static_cast<uint64_t>(b) * M * N + r0 * N], cp, pad);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            // AR = reduce along the second dimension: one max per row.
            uint32_t shape[2] = {rows, N};
            AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, false>(maxBuf, simBuf, shape, true);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);

            uint32_t s2[2] = {1, rows};
            AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR, false>(sumBuf, maxBuf, s2, true);

            AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            acc += sumBuf.GetValue(0);
        }

        // One partial per (batch, sub-block); sub-block 0 combines and writes y[b].
        AscendC::GlobalTensor<float> part = mm[static_cast<uint64_t>(M) * N * B + b * AIV_PER_CORE + subIdx];
        part.SetValue(0, acc);
        AscendC::DataCacheCleanAndInvalid<float, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                         AscendC::DcciDst::CACHELINE_OUT>(part);
        AscendC::SyncAll<false>();

        if (subIdx == 0) {
            float total = 0.0f;
            for (uint32_t s = 0; s < AIV_PER_CORE; ++s) {
                AscendC::GlobalTensor<float> pg = mm[static_cast<uint64_t>(M) * N * B + b * AIV_PER_CORE + s];
                total += pg.GetValue(0);
            }
            yGm.SetValue(b, total);
            AscendC::DataCacheCleanAndInvalid<float, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                             AscendC::DcciDst::CACHELINE_OUT>(yGm);
        }
    }

private:
    AscendC::GlobalTensor<XT> x1Gm;
    AscendC::GlobalTensor<XT> x2Gm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> mm;
    uint32_t B = 0, M = 0, N = 0, K = 0;
    uint32_t coreNum = 1, blockIdx = 0, aivNum = 1;
    bool tx1 = false, tx2 = false;
};

template <typename XT>
__global__ __mix__(1, AIV_PER_CORE) void bmms_kernel(
    __gm__ uint8_t* x1, __gm__ uint8_t* x2, __gm__ uint8_t* y, __gm__ uint8_t* mmGm,
    __gm__ uint8_t* tilingGm,
    int64_t B, int64_t M, int64_t N, int64_t K, int64_t tx1, int64_t tx2, int64_t coreNum)
{
    AscendC::InitSocState();
    TCubeTiling tiling;
    bmms::CopyTiling(&tiling, tilingGm);

    KernelBmms<XT> op;
    AscendC::TPipe pipe;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.matmulObj, &tiling);
    op.Init(x1, x2, y, mmGm, B, M, N, K, tx1 != 0, tx2 != 0, coreNum);
    op.Process(tiling);
    AscendC::PipeBarrier<PIPE_ALL>();
}

}  // namespace bmms

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const int64_t* s1 = info_x1.tensors[0].shape;
    const int64_t* s2 = info_x2.tensors[0].shape;

    const int64_t B = s1[0];
    const int64_t M = transposeX1 ? s1[2] : s1[1];
    const int64_t K = transposeX1 ? s1[1] : s1[2];
    const int64_t N = transposeX2 ? s2[1] : s2[2];

    // fp16 = 1, bf16 = 2
    const int64_t dtype = info_x1.tensors[0].dtype;

    (void)info_y;

    // ---- tiling (host side, same API the official samples use) ----
    optiling::TCubeTiling tilingData;
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
    matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);

    int64_t usedCores = availableCoreNum;
    if (usedCores > B) {
        usedCores = B;
    }
    if (usedCores < 1) {
        usedCores = 1;
    }
    tilingApi.SetDim(static_cast<int32_t>(usedCores));
    tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BFLOAT16,
                       transposeX1);
    tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BFLOAT16,
                       transposeX2);
    tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                          matmul_tiling::DataType::DT_FLOAT);
    tilingApi.SetOrgShape(M, N, K);
    tilingApi.SetShape(M, N, K);
    tilingApi.EnableBias(false);
    tilingApi.SetBufferSpace(-1, -1, -1);

    if (tilingApi.GetTiling(tilingData) == -1) {
        return;
    }

    const uint32_t tilingBytes = tilingData.GetDataSize();
    const uint32_t wsBytes = ascendcPlatform->GetLibApiWorkSpaceSize();

    // ---- device buffers ----
    // mmGm : B*M*N floats (matmul result) + one partial per (batch, AIV sub-block)
    const int64_t partFloats = static_cast<int64_t>(B) * bmms::AIV_PER_CORE + 16;
    const int64_t mmFloats = static_cast<int64_t>(B) * M * N + partFloats;

    static uint8_t* g_mm = nullptr;
    static uint8_t* g_ws = nullptr;
    static uint8_t* g_tiling = nullptr;
    static int64_t g_mmCap = 0;
    static int64_t g_wsCap = 0;
    static uint32_t g_tilingCap = 0;

    if (g_mm == nullptr || g_mmCap < mmFloats) {
        if (g_mm != nullptr) {
            aclrtFree(g_mm);
            g_mm = nullptr;
        }
        if (aclrtMalloc((void**)&g_mm, static_cast<size_t>(mmFloats) * sizeof(float),
                        ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            return;
        }
        g_mmCap = mmFloats;
    }
    if (g_ws == nullptr || g_wsCap < static_cast<int64_t>(wsBytes)) {
        if (g_ws != nullptr) {
            aclrtFree(g_ws);
            g_ws = nullptr;
        }
        if (aclrtMalloc((void**)&g_ws, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            return;
        }
        g_wsCap = wsBytes;
    }
    if (g_tiling == nullptr || g_tilingCap < tilingBytes) {
        if (g_tiling != nullptr) {
            aclrtFree(g_tiling);
            g_tiling = nullptr;
        }
        if (aclrtMalloc((void**)&g_tiling, tilingBytes, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            return;
        }
        g_tilingCap = tilingBytes;
    }

    uint8_t* tilingHost = (uint8_t*)malloc(tilingBytes);
    if (tilingHost == nullptr) {
        return;
    }
    tilingData.SaveToBuffer(tilingHost, tilingBytes);
    aclrtMemcpy(g_tiling, tilingBytes, tilingHost, tilingBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    free(tilingHost);

    if (dtype == 1) {
        bmms::bmms_kernel<half><<<usedCores, nullptr, stream>>>(
            (__gm__ uint8_t*)x1, (__gm__ uint8_t*)x2, (__gm__ uint8_t*)y, (__gm__ uint8_t*)g_mm,
            (__gm__ uint8_t*)g_tiling,
            B, M, N, K, transposeX1 ? 1 : 0, transposeX2 ? 1 : 0, usedCores);
    } else {
        bmms::bmms_kernel<bfloat16_t><<<usedCores, nullptr, stream>>>(
            (__gm__ uint8_t*)x1, (__gm__ uint8_t*)x2, (__gm__ uint8_t*)y, (__gm__ uint8_t*)g_mm,
            (__gm__ uint8_t*)g_tiling,
            B, M, N, K, transposeX1 ? 1 : 0, transposeX2 ? 1 : 0, usedCores);
    }
}
