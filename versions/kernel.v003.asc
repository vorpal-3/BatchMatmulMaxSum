#include <cmath>
#include "kernel_operator.h"

/*
 * BatchMatmulMaxSum — Ascend C Direct Invocation
 *
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 *   y[b] = sum_m ( max_n ( sum_k x1[b,m,k] * x2[b,k,n] ) )
 *
 * WHY __mix__ INSTEAD OF __cube__
 * -------------------------------
 * The judge profiles each iteration and requires EXACTLY ONE kernel launch
 * ("Profiling rule violated: each iteration must launch exactly 1 kernel"), so the
 * matmul and both reductions must live in a single kernel. On dav-2201 the cube
 * engine (AIC) and the vector engine (AIV) are separate, and only AIV can run the
 * reductions, so the kernel is declared __mix__(1, 2): 1 AIC + 2 AIV per logical
 * core. The intermediate (M,N) matrix is staged in GM because 2201 has no
 * cube->vector UB path (that exists only on the 3510 family).
 *
 *   AIC: ND2NZ GM->L1 -> LoadData L1->L0A/L0B -> Mmad -> Fixpipe L0C->GM
 *        then CrossCoreSetFlag<0x2, PIPE_FIX>(0x8)
 *   AIV: CrossCoreWaitFlag<0x2>(0x8) -> DataCopyPad GM->UB
 *        -> ReduceMax(N) -> ReduceSum(M) -> y[b]
 *
 * GROUNDING (official asc-devkit CANN 9.0 sources, 2201 branches):
 *   examples/01_simd_cpp_api/03_basic_api/03_matrix_compute/batch_matmul/batch_matmul.asc
 *   examples/01_simd_cpp_api/05_best_practices/03_fusion_compute/matmul_gelu_high_performance/mmad_gelu.asc
 *   examples/01_simd_cpp_api/04_advanced_api/04_reduce/reducemax/reducemax.asc
 *
 * V0 STATUS: correctness-first, NOT yet verified. No NPU and no CANN toolkit exist on
 * the development machine, so this has never been compiled. The first CANNJudge
 * submission exists to collect the compiler's verdict, not to score.
 */

namespace bmms {

constexpr uint32_t BASE_M = 128;
constexpr uint32_t BASE_N = 128;
constexpr uint8_t CROSS_CORE_FLAG_ID = 0x8;
constexpr uint32_t AIV_PER_CORE = 2;

__aicore__ inline uint32_t AlignUp(uint32_t v, uint32_t a)
{
    return (v + a - 1) / a * a;
}

template <typename DT>
class KernelBmms {
public:
    __aicore__ inline KernelBmms() {}

    __aicore__ inline void Init(
        __gm__ uint8_t* x1, __gm__ uint8_t* x2, __gm__ uint8_t* y, __gm__ uint8_t* ws,
        int64_t B, int64_t M, int64_t N, int64_t K, bool tx1, bool tx2, int64_t coreNum)
    {
        x1Gm.SetGlobalBuffer((__gm__ DT*)x1);
        x2Gm.SetGlobalBuffer((__gm__ DT*)x2);
        yGm.SetGlobalBuffer((__gm__ float*)y);
        wsGm.SetGlobalBuffer((__gm__ float*)ws);

        this->B = static_cast<uint32_t>(B);
        this->M = static_cast<uint32_t>(M);
        this->N = static_cast<uint32_t>(N);
        this->K = static_cast<uint32_t>(K);
        this->tx1 = tx1;
        this->tx2 = tx2;
        this->coreNum = static_cast<uint32_t>(coreNum);
        this->blockIdx = AscendC::GetBlockIdx();
        this->c0 = 32 / sizeof(DT);
    }

    __aicore__ inline void Process()
    {
        for (uint32_t b = blockIdx; b < B; b += coreNum) {
            if ASCEND_IS_AIC {
                ComputeMatmul(b);
            }
            if ASCEND_IS_AIV {
                ReduceBatch(b);
            }
        }
    }

private:
    // ========================= AIC side =========================
    __aicore__ inline void ComputeMatmul(uint32_t b)
    {
        const uint32_t mTiles = (M + BASE_M - 1) / BASE_M;
        const uint32_t nTiles = (N + BASE_N - 1) / BASE_N;
        const uint32_t kAl = AlignUp(K, c0);

        for (uint32_t nt = 0; nt < nTiles; ++nt) {
            for (uint32_t mt = 0; mt < mTiles; ++mt) {
                const uint32_t mCur = (mt + 1 == mTiles) ? (M - mt * BASE_M) : BASE_M;
                const uint32_t nCur = (nt + 1 == nTiles) ? (N - nt * BASE_N) : BASE_N;
                const uint32_t mAl = AlignUp(mCur, 16);
                const uint32_t nAl = AlignUp(nCur, 16);

                AscendC::LocalTensor<DT> a1(AscendC::TPosition::A1, 0, mAl * kAl);
                AscendC::LocalTensor<DT> b1(AscendC::TPosition::B1, 0, kAl * nAl);
                AscendC::LocalTensor<DT> a2(AscendC::TPosition::A2, 0, mAl * kAl);
                AscendC::LocalTensor<DT> b2(AscendC::TPosition::B2, 0, kAl * nAl);
                AscendC::LocalTensor<float> c1(AscendC::TPosition::CO1, 0, mAl * nAl);

                LoadToL1(a1, b1, b, mt, nt, mAl, nAl);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

                LoadToL0(a2, b2, a1, b1, mAl, nAl, kAl);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID0);

                AscendC::MmadParams mm;
                mm.m = mCur;
                mm.n = nCur;
                mm.k = K;
                AscendC::Mmad(c1, a2, b2, mm);

                AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID0);

                StoreTileToGm(c1, b, mt, nt, mCur, nCur, mAl);

                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(EVENT_ID0);
            }
        }

        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(CROSS_CORE_FLAG_ID);
    }

    // GM -> L1 with on-the-fly ND2NZ. tx1/tx2 decide which two logical dims the
    // ND matrix carries; no separate transpose pass is performed.
    __aicore__ inline void LoadToL1(
        AscendC::LocalTensor<DT>& a1, AscendC::LocalTensor<DT>& b1,
        uint32_t b, uint32_t mt, uint32_t nt, uint32_t mAl, uint32_t nAl)
    {
        const uint32_t mOff = mt * BASE_M;
        const uint32_t nOff = nt * BASE_N;

        AscendC::Nd2NzParams pa;
        pa.ndNum = 1;
        pa.nValue = tx1 ? static_cast<uint16_t>(BASE_M) : static_cast<uint16_t>(BASE_M);
        pa.dValue = tx1 ? static_cast<uint16_t>(BASE_M) : static_cast<uint16_t>(K);
        pa.srcDValue = tx1 ? static_cast<uint16_t>(BASE_M) : static_cast<uint16_t>(K);
        pa.srcNdMatrixStride = 0;
        pa.dstNzC0Stride = static_cast<uint16_t>(mAl);
        pa.dstNzNStride = 1;
        pa.dstNzMatrixStride = 0;
        {
            AscendC::GlobalTensor<DT> g;
            if (tx1) {
                // storage (B,K,M): the M slab is contiguous along its last dim
                g.SetGlobalBuffer(x1Gm[b * K * M + mOff]);
                pa.nValue = static_cast<uint16_t>(K);
                pa.dValue = static_cast<uint16_t>(BASE_M);
                pa.srcDValue = static_cast<uint16_t>(M);
            } else {
                g.SetGlobalBuffer(x1Gm[b * M * K + mOff * K]);
                pa.nValue = static_cast<uint16_t>(BASE_M);
                pa.dValue = static_cast<uint16_t>(K);
                pa.srcDValue = static_cast<uint16_t>(K);
            }
            AscendC::DataCopy(a1, g, pa);
        }

        AscendC::Nd2NzParams pb;
        pb.ndNum = 1;
        pb.srcNdMatrixStride = 0;
        pb.dstNzC0Stride = static_cast<uint16_t>(nAl);
        pb.dstNzNStride = 1;
        pb.dstNzMatrixStride = 0;
        {
            AscendC::GlobalTensor<DT> g;
            if (tx2) {
                // storage (B,N,K)
                g.SetGlobalBuffer(x2Gm[b * N * K + nOff * K]);
                pb.nValue = static_cast<uint16_t>(BASE_N);
                pb.dValue = static_cast<uint16_t>(K);
                pb.srcDValue = static_cast<uint16_t>(K);
            } else {
                g.SetGlobalBuffer(x2Gm[b * K * N + nOff]);
                pb.nValue = static_cast<uint16_t>(K);
                pb.dValue = static_cast<uint16_t>(BASE_N);
                pb.srcDValue = static_cast<uint16_t>(N);
            }
            AscendC::DataCopy(b1, g, pb);
        }
    }

    // L1 -> L0A/L0B. The storage-layout variants are absorbed here by the load
    // unit, which is why transposeX1/transposeX2 cost no extra transpose pass.
    __aicore__ inline void LoadToL0(
        AscendC::LocalTensor<DT>& a2, AscendC::LocalTensor<DT>& b2,
        AscendC::LocalTensor<DT>& a1, AscendC::LocalTensor<DT>& b1,
        uint32_t mAl, uint32_t nAl, uint32_t kAl)
    {
        AscendC::LoadData2DParams la;
        la.repeatTimes = static_cast<uint16_t>((kAl + c0 - 1) / c0);
        la.srcStride = static_cast<uint16_t>((mAl + 15) / 16);
        la.dstGap = 0;
        la.ifTranspose = tx1;
        const uint32_t mSteps = (mAl + 15) / 16;
        for (uint32_t i = 0; i < mSteps; ++i) {
            AscendC::LoadData(a2[i * la.repeatTimes * 16 * c0], a1[i * c0], la);
        }

        AscendC::LoadData3DParamsV2<DT> lb;
        lb.l1H = static_cast<uint16_t>(kAl);
        lb.l1W = 1;
        lb.channelSize = static_cast<uint16_t>(nAl);
        lb.kExtension = static_cast<uint16_t>(nAl);
        lb.mExtension = static_cast<uint16_t>(kAl);
        lb.strideW = 1;
        lb.strideH = 1;
        lb.filterW = 1;
        lb.filterH = 1;
        lb.dilationFilterW = 1;
        lb.dilationFilterH = 1;
        lb.filterSizeW = false;
        lb.filterSizeH = false;
        lb.enTranspose = !tx2;
        lb.fMatrixCtrl = false;
        AscendC::LoadData(b2, b1, lb);
    }

    __aicore__ inline void StoreTileToGm(
        AscendC::LocalTensor<float>& c1,
        uint32_t b, uint32_t mt, uint32_t nt, uint32_t mCur, uint32_t nCur, uint32_t mAl)
    {
        AscendC::FixpipeParamsV220 fp;
        fp.nSize = static_cast<uint16_t>(nCur);
        fp.mSize = static_cast<uint16_t>(mCur);
        fp.srcStride = static_cast<uint16_t>(mAl);
        fp.dstStride = static_cast<uint32_t>(N);
        fp.ndNum = 1;
        fp.srcNdStride = 0;
        fp.dstNdStride = 0;

        AscendC::Fixpipe(wsGm[b * M * N + mt * BASE_M * N + nt * BASE_N], c1, fp);
    }

    // ========================= AIV side =========================
    __aicore__ inline void ReduceBatch(uint32_t b)
    {
        AscendC::CrossCoreWaitFlag<0x2>(CROSS_CORE_FLAG_ID);

        const uint32_t subIdx = AscendC::GetSubBlockIdx() % AIV_PER_CORE;
        const uint32_t rowsPerSub = (M + AIV_PER_CORE - 1) / AIV_PER_CORE;
        const uint32_t mBegin = subIdx * rowsPerSub;
        const uint32_t mEnd = (mBegin + rowsPerSub < M) ? (mBegin + rowsPerSub) : M;
        if (mBegin >= mEnd) {
            return;
        }

        // Keep one row-chunk plus temporaries inside UB.
        const uint32_t nAl = AlignUp(N, 8);
        uint32_t chunkRows = 8;
        while (chunkRows > 1 && static_cast<uint64_t>(chunkRows) * nAl * sizeof(float) > 64 * 1024) {
            chunkRows /= 2;
        }

        const uint32_t simOff = 0;
        const uint32_t maxOff = chunkRows * nAl;
        const uint32_t tmpOff = maxOff + chunkRows;
        const uint32_t sumOff = tmpOff + 1024;

        AscendC::LocalTensor<float> simBuf(AscendC::TPosition::VECCALC, simOff * sizeof(float), chunkRows * nAl);
        AscendC::LocalTensor<float> maxBuf(AscendC::TPosition::VECCALC, maxOff * sizeof(float), chunkRows);
        AscendC::LocalTensor<float> tmpBuf(AscendC::TPosition::VECCALC, tmpOff * sizeof(float), 1024);
        AscendC::LocalTensor<float> sumBuf(AscendC::TPosition::VECCALC, sumOff * sizeof(float), 8);

        AscendC::Duplicate<float>(sumBuf, 0.0f, 8);
        AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
        float acc = 0.0f;

        for (uint32_t r0 = mBegin; r0 < mEnd; r0 += chunkRows) {
            const uint32_t rows = (r0 + chunkRows < mEnd) ? chunkRows : (mEnd - r0);

            AscendC::DataCopyExtParams cp;
            cp.blockCount = static_cast<uint16_t>(rows);
            cp.blockLen = static_cast<uint32_t>(N * sizeof(float));
            cp.srcStride = 0;
            cp.dstStride = 0;
            AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
            AscendC::DataCopyPad<float>(simBuf, wsGm[b * M * N + r0 * N], cp, pad);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            // AR = reduce along the second dimension: one max per row.
            uint32_t shape[2] = {rows, N};
            AscendC::ReduceMax<float, AscendC::Pattern::Reduce::AR, false>(
                maxBuf, simBuf, shape, true);

            AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);

            // Stage 2: sum the row maxima of this chunk.
            uint32_t s2[2] = {1, rows};
            AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR, false>(
                sumBuf, maxBuf, s2, true);
            AscendC::SetFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_S>(EVENT_ID0);
            acc += sumBuf.GetValue(0);
        }

        // Hand each AIV's partial to GM; AIV0 of this core sums them and writes y[b].
        AscendC::GlobalTensor<float> partGm = wsGm[B * M * N + b * AIV_PER_CORE + subIdx];
        partGm.SetValue(0, acc);
        AscendC::DataCacheCleanAndInvalid<float, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                         AscendC::DcciDst::CACHELINE_OUT>(partGm);
        AscendC::SyncAll<false>();

        if (subIdx == 0) {
            float total = 0.0f;
            for (uint32_t s = 0; s < AIV_PER_CORE; ++s) {
                AscendC::GlobalTensor<float> pg = wsGm[B * M * N + b * AIV_PER_CORE + s];
                total += pg.GetValue(0);
            }
            yGm.SetValue(b, total);
            AscendC::DataCacheCleanAndInvalid<float, AscendC::CacheLine::SINGLE_CACHE_LINE,
                                             AscendC::DcciDst::CACHELINE_OUT>(yGm);
        }
    }

private:
    AscendC::GlobalTensor<DT> x1Gm;
    AscendC::GlobalTensor<DT> x2Gm;
    AscendC::GlobalTensor<float> yGm;
    AscendC::GlobalTensor<float> wsGm;
    uint32_t B = 0, M = 0, N = 0, K = 0;
    uint32_t c0 = 16;
    uint32_t coreNum = 1;
    uint32_t blockIdx = 0;
    bool tx1 = false;
    bool tx2 = false;
};

template <typename DT>
__global__ __mix__(1, AIV_PER_CORE) void bmms_kernel(
    __gm__ uint8_t* x1, __gm__ uint8_t* x2, __gm__ uint8_t* y, __gm__ uint8_t* ws,
    int64_t B, int64_t M, int64_t N, int64_t K, int64_t tx1, int64_t tx2, int64_t coreNum)
{
    AscendC::InitSocState();
    KernelBmms<DT> op;
    op.Init(x1, x2, y, ws, B, M, N, K, tx1 != 0, tx2 != 0, coreNum);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

}  // namespace bmms

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1, GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1,
    bool transposeX2)
{
    const int64_t* s1 = info_x1.tensors[0].shape;
    const int64_t* s2 = info_x2.tensors[0].shape;

    const int64_t B = s1[0];
    const int64_t M = transposeX1 ? s1[2] : s1[1];
    const int64_t K = transposeX1 ? s1[1] : s1[2];
    const int64_t N = transposeX2 ? s2[1] : s2[2];

    const int64_t dtype = info_x1.tensors[0].dtype;   // 1=fp16, 2=bf16

    // Cube->vector staging area for (M,N) float, plus two partial-sum slots per batch.
    const int64_t wsFloats = B * M * N + B * bmms::AIV_PER_CORE + 16;
    static uint8_t* ws = nullptr;
    static int64_t wsCapacity = 0;
    if (ws == nullptr || wsCapacity < wsFloats) {
        if (ws != nullptr) {
            aclrtFree(ws);
            ws = nullptr;
        }
        if (aclrtMalloc((void**)&ws, static_cast<size_t>(wsFloats) * sizeof(float),
                        ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            return;
        }
        wsCapacity = wsFloats;
    }

    int64_t blockNum = availableCoreNum;
    if (blockNum > B) {
        blockNum = B;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    if (dtype == 1) {
        bmms::bmms_kernel<half><<<blockNum, nullptr, stream>>>(
            (__gm__ uint8_t*)x1, (__gm__ uint8_t*)x2, (__gm__ uint8_t*)y, (__gm__ uint8_t*)ws,
            B, M, N, K, transposeX1 ? 1 : 0, transposeX2 ? 1 : 0, blockNum);
    } else {
        bmms::bmms_kernel<bfloat16_t><<<blockNum, nullptr, stream>>>(
            (__gm__ uint8_t*)x1, (__gm__ uint8_t*)x2, (__gm__ uint8_t*)y, (__gm__ uint8_t*)ws,
            B, M, N, K, transposeX1 ? 1 : 0, transposeX2 ? 1 : 0, blockNum);
    }
}
